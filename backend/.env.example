# ============================================================
# VibeHosting Backend — Environment Variables
# Copy to .env and fill in real values.   chmod 600 .env
# ============================================================

DATABASE_URL="postgresql://user:CHANGE_ME@localhost:5432/vibe_hosting"
JWT_SECRET="CHANGE_ME_TO_128_CHAR_HEX"
PORT=7001
HOST=127.0.0.1
REDIS_URL="redis://localhost:6379/4"
UPLOAD_DIR="/var/www/vibe-hosting/uploads"
SITES_DIR="/var/www/vibe-hosting/sites"
BACKUPS_DIR="/var/www/vibe-hosting/backups"
CORS_ORIGINS='["http://localhost:3000","http://localhost:7002","https://hostingvibe.ru"]'

# SMTP (Yandex Mail for Domain)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@example.com"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="VibeHosting <noreply@hostingvibe.ru>"
FRONTEND_URL="https://hostingvibe.ru"

# Prodamus
PRODAMUS_PAYFORM_URL="https://convert.payform.ru"
PRODAMUS_SECRET_KEY="CHANGE_ME"
PRODAMUS_SYSTEM_CODE="otclick"
PRODAMUS_SUBSCRIPTION_ID=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="Vibehostingbot"
